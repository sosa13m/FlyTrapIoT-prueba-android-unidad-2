<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.FlyTrapIoT" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/bosque</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/trampa</item>
        <item name="colorOnSecondary">@color/bosque</item>
        <item name="colorError">@color/nivel_alto</item>
        <item name="android:colorBackground">@color/crema</item>
        <item name="android:windowBackground">@color/crema</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.FlyTrapIoT" parent="Base.Theme.FlyTrapIoT" />

    <style name="FlyTrapCampo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/bosque</item>
        <item name="hintTextColor">@color/bosque</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <style name="FlyTrapEtiqueta">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/trampa</item>
    </style>
</resources>
